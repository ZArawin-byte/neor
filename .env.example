# Copy to .env and fill in. Anything left blank falls back to demo mode,
# so the app always runs (handy when the hackathon wifi dies).

# --- Supabase (auth + database + private photo storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq (free, fast LLM inference) ---
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- CORS: comma-separated URLs where the frontend runs ---
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# --- AI lane: Perceptron care-label OCR (key from the Perceptron workshop). Blank = Groq vision fallback ---
PERCEPTRON_API_KEY=
PERCEPTRON_MODEL=perceptron-mk1.5
AI_TIMEOUT_SECONDS=20

# --- core lane: demo account (Supabase email/password user) made by scripts/seed_demo.py ---
DEMO_EMAIL=
# Only read by the seed script; the account holds fictional data and is reset with reset_demo.py.
DEMO_PASSWORD=

# --- Bargain market (optional) ---
# Photo identification. A Google Cloud API key restricted to Cloud Vision API (server use, so no referrer restriction).
GOOGLE_VISION_API_KEY=
# Live online prices and Google Maps store search, via https://serpapi.com. Without it, shops come from OpenStreetMap.
SERPAPI_API_KEY=

# --- Lazy mode texts (optional). From https://console.twilio.com. Without them, texts go to the server log. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number (+12065550123) or a Messaging Service SID (MG...)
TWILIO_FROM=

# --- Lazy mode by email (free). A Gmail address + an app password from
# https://myaccount.google.com/apppasswords (needs 2-Step Verification on). Not your normal password. ---
SMTP_USER=
SMTP_PASSWORD=
