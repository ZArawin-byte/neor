# Copy to .env and fill in. Anything left blank falls back to demo mode,
# so the app always runs (handy when the hackathon wifi dies).

# --- Supabase (auth + database + private photo storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq (free, fast LLM inference) ---
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- CORS: comma-separated URLs where the frontend runs ---
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
